{
  "name": "@irrumi/repopolish",
  "version": "0.1.0",
  "description": "Offline documentation audits and reviewable fixes grounded in repository metadata.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "repopolish": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "integrations",
    "docs",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/irrumi/RepoPolish.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/package-smoke.mjs",
    "self-audit": "node dist/cli.js audit . --ci",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run smoke && npm run self-audit"
  },
  "dependencies": {
    "diff": "9.0.0",
    "github-slugger": "2.0.0",
    "ignore": "7.0.10",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "semver": "7.8.5",
    "smol-toml": "1.9.0",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.0",
    "@types/semver": "7.8.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
